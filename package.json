{
  "name": "padelbuddy-web",
  "version": "0.15.0",
  "private": true,
  "description": "A mobile-first, client-only Padel score tracker optimized for courtside use with Bluetooth remote and touch controls.",
  "keywords": [
    "mobile",
    "padel",
    "score",
    "sports",
    "tennis",
    "tracker",
    "web"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm tokens:build && vite",
    "build": "pnpm tokens:build && vite build",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.json",
    "prepare": "husky",
    "lint": "pnpm lint:oxlint && pnpm lint:stylelint",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "pnpm lint:fix:oxlint && pnpm lint:fix:stylelint",
    "lint:fix:oxlint": "oxlint --fix --deny-warnings",
    "lint:fix:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest run --coverage --watch",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "complete-check": "pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "~1.2.0",
    "@fontsource/inter": "~5.2.8",
    "@fontsource/outfit": "~5.2.8",
    "@tanstack/react-router": "~1.166.3",
    "@tanstack/react-start": "~1.166.3",
    "i18next": "~25.8.18",
    "i18next-http-backend": "~3.0.2",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-i18next": "~16.5.8"
  },
  "devDependencies": {
    "@commitlint/cli": "~20.4.3",
    "@commitlint/config-conventional": "~20.4.3",
    "@playwright/test": "~1.58.2",
    "@types/node": "~24.12.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~5.1.4",
    "@vitest/browser-playwright": "~4.0.18",
    "@vitest/coverage-v8": "~4.0.18",
    "husky": "~9.1.7",
    "lint-staged": "~16.3.3",
    "oxfmt": "~0.37.0",
    "oxlint": "~1.52.0",
    "oxlint-tsgolint": "~0.16.0",
    "playwright": "~1.58.2",
    "style-dictionary": "~5.1.1",
    "stylelint": "~16.25.0",
    "stylelint-config-standard": "~39.0.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.1",
    "vite-plugin-killer-instincts": "~1.0.0",
    "vite-tsconfig-paths": "~6.1.1",
    "vitest": "~4.0.18",
    "vitest-browser-react": "~2.0.5"
  },
  "engines": {
    "node": "^24.14.0",
    "pnpm": "^10.32.0"
  },
  "packageManager": "pnpm@10.32.0"
}
