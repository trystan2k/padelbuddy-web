{
  "name": "padelbuddy-web",
  "version": "2.7.0",
  "private": true,
  "description": "A mobile-first, client-only Padel score tracker optimized for courtside use with Bluetooth remote and touch controls.",
  "keywords": [
    "mobile",
    "padel",
    "score",
    "sports",
    "tennis",
    "tracker",
    "web"
  ],
  "type": "module",
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "vite",
    "prebuild": "pnpm tokens:build",
    "build": "vite build",
    "sync:mobile": "VITE_IS_NATIVE=true pnpm build && pnpm exec cap sync",
    "open:android": "pnpm sync:mobile && pnpm exec cap open android",
    "open:ios": "pnpm sync:mobile && pnpm exec cap open ios",
    "tokens:build": "style-dictionary build --config design-tokens/style-dictionary.config.json",
    "prepare": "husky",
    "lint": "pnpm lint:oxlint && pnpm lint:stylelint",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "pnpm lint:fix:oxlint && pnpm lint:fix:stylelint",
    "lint:fix:oxlint": "oxlint --fix --deny-warnings",
    "lint:fix:stylelint": "stylelint \"src/**/*.css\" --allow-empty-input --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest run --coverage --watch",
    "pretest": "pnpm tokens:build",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "complete-check": "pnpm knip:fix && pnpm typecheck && pnpm lint:fix && pnpm format && pnpm test && pnpm test:e2e && pnpm build",
    "knip": "knip",
    "knip:fix": "pnpm knip --fix"
  },
  "dependencies": {
    "@base-ui/react": "~1.3.0",
    "@fontsource/inter": "~5.2.8",
    "@fontsource/outfit": "~5.2.8",
    "@tanstack/react-router": "~1.168.10",
    "@tanstack/react-start": "~1.167.16",
    "i18next": "~26.0.3",
    "mixpanel-browser": "~2.77.0",
    "modern-screenshot": "~4.6.8",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-i18next": "~17.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "~8.3.0",
    "@capacitor/cli": "~8.3.0",
    "@capacitor/core": "~8.3.0",
    "@capacitor/ios": "~8.3.0",
    "@commitlint/cli": "~20.5.0",
    "@commitlint/config-conventional": "~20.5.0",
    "@playwright/test": "~1.59.1",
    "@types/node": "~24.12.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.1",
    "@vitest/browser-playwright": "~4.1.2",
    "@vitest/coverage-v8": "~4.1.2",
    "husky": "~9.1.7",
    "knip": "~6.3.1",
    "lint-staged": "~16.4.0",
    "oxfmt": "~0.43.0",
    "oxlint": "~1.58.0",
    "oxlint-tsgolint": "~0.19.0",
    "playwright": "~1.59.1",
    "style-dictionary": "~5.4.0",
    "stylelint": "~17.6.0",
    "stylelint-config-standard": "~40.0.0",
    "typescript": "~6.0.2",
    "vite": "~8.0.5",
    "vite-plugin-killer-instincts": "~1.1.0",
    "vitest": "~4.1.2",
    "vitest-browser-react": "~2.0.5"
  },
  "engines": {
    "node": "^24.14.1",
    "pnpm": "^10.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
